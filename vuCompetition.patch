+                  <View key={text} style={styles.ruleItem}>
+                    <View style={styles.bullet} />
+                    <Text style={styles.ruleText}>{text}</Text>
+                  </View>
+                ))}
+              </View>
+            ))}
+          </View>
+        </ScrollView>
+      </SafeAreaView>
+    </LinearGradient>
+  );
+};
