+            <Ionicons name="arrow-back" size={moderateScale(20)} color={VU.white} />
+          </TouchableOpacity>
+          <Text style={styles.headerTitle}>VU Trading Competition</Text>
+          <View style={styles.headerBtn} />
+        </View>
