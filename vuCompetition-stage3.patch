+import React, { useEffect, useState } from "react";
+import { StyleSheet, Text, View } from "react-native";
+import { LinearGradient } from "expo-linear-gradient";
+import { Ionicons } from "@expo/vector-icons";
+
+import { VU } from "../constants/vuCompetition";
+import { fontScale, moderateScale } from "../theme";
+
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
+const pad = (n) => String(n).padStart(2, "0");
+
+/** "18 Nov, 12:00 PM" in IST, whatever the phone's time zone is. */
+export function formatIst(iso) {
+  const t = Date.parse(iso);
+  if (Number.isNaN(t)) return "";
+  const d = new Date(t + IST_OFFSET_MS); // read with the UTC getters = IST wall clock
+  const h = d.getUTCHours();
+  const h12 = h % 12 === 0 ? 12 : h % 12;
+  return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}, ${h12}:${pad(d.getUTCMinutes())} ${h >= 12 ? "PM" : "AM"}`;
+}
+
+/** { days, hours, minutes, seconds, done } until `targetMs`. */
+export function timeLeft(targetMs, nowMs) {
+  const diff = Math.max(0, targetMs - nowMs);
+  const total = Math.floor(diff / 1000);
+  return {
+    days: Math.floor(total / 86400),
+    hours: Math.floor((total % 86400) / 3600),
+    minutes: Math.floor((total % 3600) / 60),
+    seconds: total % 60,
+    done: diff === 0,
+  };
+}
+
+/**
+ * CompetitionCountdown: a box counting down to the contest start.
+ *
+ * Props:
+ *   startsAt    ISO string, the moment the contest starts (from the server)
+ *   offsetMs    server clock minus phone clock, so a wrong phone clock can't skew it
+ */
+export default function CompetitionCountdown({ startsAt, offsetMs = 0 }) {
+  const target = Date.parse(startsAt);
+  const valid = !Number.isNaN(target);
+  const [now, setNow] = useState(Date.now() + offsetMs);
+
+  useEffect(() => {
+    if (!valid) return undefined;
+    setNow(Date.now() + offsetMs);
+    const id = setInterval(() => setNow(Date.now() + offsetMs), 1000);
+    return () => clearInterval(id);
+  }, [valid, offsetMs]);
+
+  if (!valid) return null;
+  const left = timeLeft(target, now);
+
+  if (left.done) {
+    return (
+      <View style={styles.startedBox}>
+        <Ionicons name="flash" size={moderateScale(18)} color={VU.orangeDeep} />
+        <Text style={styles.startedText}>The contest has started!</Text>
+      </View>
+    );
+  }
+
+  const units = [
+    { label: "Days", value: left.days },
+    { label: "Hours", value: left.hours },
+    { label: "Mins", value: left.minutes },
+    { label: "Secs", value: left.seconds },
+  ];
+  const a11y = `Contest starts in ${left.days} days, ${left.hours} hours, ${left.minutes} minutes`;
+
+  return (
+    <LinearGradient
+      colors={[VU.blueLight, VU.blue, VU.blueDeep]}
+      start={{ x: 0, y: 0 }}
+      end={{ x: 1, y: 1 }}
+      style={styles.box}
+      accessible
+      accessibilityLabel={a11y}
+    >
+      <Text style={styles.heading}>Contest starts in</Text>
+      <View style={styles.row}>
+        {units.map((u) => (
+          <View key={u.label} style={styles.tile}>
+            <Text style={styles.value}>{pad(u.value)}</Text>
+            <Text style={styles.unit}>{u.label}</Text>
+          </View>
+        ))}
+      </View>
+      <Text style={styles.when}>{formatIst(startsAt)} IST</Text>
+    </LinearGradient>
+  );
+}
+
+const styles = StyleSheet.create({
+  box: {
+    borderRadius: 20,
+    padding: moderateScale(16),
+    marginTop: moderateScale(16),
+    overflow: "hidden",
+  },
+  heading: {
+    color: VU.white,
+    fontSize: fontScale(13),
+    fontWeight: "600",
+    textAlign: "center",
+    opacity: 0.9,
+  },
+  row: {
+    flexDirection: "row",
+    justifyContent: "space-between",
+    marginTop: moderateScale(12),
+  },
+  tile: {
+    flex: 1,
+    alignItems: "center",
+    backgroundColor: VU.white,
+    borderRadius: 14,
+    paddingVertical: moderateScale(10),
+    marginHorizontal: moderateScale(4),
+  },
+  value: {
+    color: VU.blueDeep,
+    fontSize: fontScale(24),
+    fontWeight: "800",
+    fontVariant: ["tabular-nums"],
+  },
+  unit: {
+    color: VU.orangeDeep,
+    fontSize: fontScale(11),
+    fontWeight: "700",
+    marginTop: 2,
+  },
+  when: {
+    color: VU.white,
+    fontSize: fontScale(12),
+    fontWeight: "600",
+    textAlign: "center",
+    marginTop: moderateScale(12),
+  },
+  startedBox: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "center",
+    backgroundColor: "#FFF3E8",
+    borderRadius: 16,
+    paddingVertical: moderateScale(14),
+    marginTop: moderateScale(16),
+  },
+  startedText: {
+    color: VU.orangeDeep,
+    fontSize: fontScale(14),
+    fontWeight: "700",
+    marginLeft: moderateScale(8),
+  },
+});
diff --git a/Stocksy_Mobile/src/hooks/useAppFeatures.js b/Stocksy_Mobile/src/hooks/useAppFeatures.js
new file mode 100644
index 0000000..9fb3443
--- /dev/null
+++ b/Stocksy_Mobile/src/hooks/useAppFeatures.js
@@ -0,0 +1,108 @@
+import { useEffect, useState } from "react";
+import { AppState } from "react-native";
+
+import { fetchAppFeatures } from "../../services/featureService";
+
+// Remote on/off switches from the server, shared by every screen. One copy lives
+// here in memory (no request per render); it is refreshed
+//   - when a screen that needs it first opens (launch),
+//   - whenever the app comes back to the foreground,
+//   - on a manual pull-to-refresh (call `refresh({ force: true })`).
+//
+// The server decides what is allowed; this only decides what to SHOW. If the
+// switches can't be fetched (offline, server down, garbled answer) we keep what
+// was last shown, but hold back anything that would START something (joining,
+// trading) until a good answer arrives, and show nothing new.
+
+const OFF = {
+  competition_visible: false,
+  competition_registration_open: false,
+  competition_enabled: false,
+};
+
+const MIN_GAP_MS = 5000; // don't refetch more often than this unless forced
+
+let state = {
+  features: OFF,
+  settings: { competition_starts_at: null },
+  serverOffsetMs: 0, // server clock minus phone clock, so a wrong phone clock can't skew the countdown
+  loaded: false, // a fetch has finished (good or bad)
+  stale: false, // the last fetch failed
+};
+const listeners = new Set();
+let inflight = null;
+let lastFetch = 0;
+let appStateSub = null;
+
+const emit = () => listeners.forEach((l) => l(state));
+
+// Only a real `true` counts as on.
+const strictFlags = (raw) => {
+  const out = { ...OFF };
+  for (const key of Object.keys(OFF)) out[key] = raw?.[key] === true;
+  return out;
+};
+
+export function refreshAppFeatures({ force = false } = {}) {
+  if (inflight) return inflight;
+  if (!force && Date.now() - lastFetch < MIN_GAP_MS) return Promise.resolve(state);
+
+  inflight = (async () => {
+    try {
+      const data = await fetchAppFeatures();
+      const serverMs = Date.parse(data.serverTime);
+      state = {
+        features: strictFlags(data.features),
+        settings: { competition_starts_at: data.settings?.competition_starts_at || null },
+        serverOffsetMs: Number.isNaN(serverMs) ? state.serverOffsetMs : serverMs - Date.now(),
+        loaded: true,
+        stale: false,
+      };
+    } catch {
+      // Keep what was last shown, but nothing that starts an action stays on.
+      state = {
+        ...state,
+        features: {
+          ...state.features,
+          competition_registration_open: false,
+          competition_enabled: false,
+        },
+        loaded: true,
+        stale: true,
+      };
+    } finally {
+      lastFetch = Date.now();
+      inflight = null;
+      emit();
+    }
+    return state;
+  })();
+  return inflight;
+}
+
+// One listener for the whole app: refresh when it returns to the foreground.
+function ensureForegroundRefresh() {
+  if (appStateSub) return;
+  let last = AppState.currentState;
+  appStateSub = AppState.addEventListener("change", (next) => {
+    if (/inactive|background/.test(last) && next === "active") refreshAppFeatures();
+    last = next;
+  });
+}
+
+/** { features, settings, serverOffsetMs, loaded, stale, refresh } */
+export default function useAppFeatures() {
+  const [snapshot, setSnapshot] = useState(state);
+
+  useEffect(() => {
+    listeners.add(setSnapshot);
+    setSnapshot(state);
+    ensureForegroundRefresh();
+    refreshAppFeatures();
+    return () => {
+      listeners.delete(setSnapshot);
+    };
+  }, []);
+
+  return { ...snapshot, refresh: refreshAppFeatures };
+}
