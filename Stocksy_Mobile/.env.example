# Stocksy_Mobile/.env.example  ->  copy to  Stocksy_Mobile/.env   (LOCAL DEVELOPMENT)
#
# Expo bakes EXPO_PUBLIC_* values into the app at build time, and they are
# visible to anyone who opens the app/site: never put a secret here.
# After editing, restart with:  npx expo start -c
#
# The web PWA and the native app use the SAME API origin.

# Local server. On a phone / Android emulator use your PC's LAN IP, not
# localhost (e.g. 192.168.1.42). On the web build in a browser, localhost works.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5050/api
EXPO_PUBLIC_WS_URL=ws://localhost:5050
EXPO_PUBLIC_API_TIMEOUT=10000

# Google OAuth *Web* client id (public value)
EXPO_PUBLIC_WEB_CLIENT_ID=

# Optional dev switches
# EXPO_PUBLIC_ENABLE_SW_IN_DEV=true
# EXPO_PUBLIC_PWA_DEBUG=true
