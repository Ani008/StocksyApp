# Stocksy_Mobile/.env.production.example  ->  copy to  Stocksy_Mobile/.env.production
#
# Used by the PRODUCTION WEB build:   npm run build:web   (expo export)
# Native store builds get the same values from eas.json, so keep the two in sync.
#
# One API origin for the web PWA and the native app.

EXPO_PUBLIC_API_BASE_URL=https://api.stocksy.online/api
EXPO_PUBLIC_WS_URL=wss://api.stocksy.online
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_WEB_CLIENT_ID=485541032381-805pb79sov4e3sbtt3e0t2flufqkksev.apps.googleusercontent.com
