# Stocksy_Server/.env.example  ->  copy to  Stocksy_Server/.env  (never commit the real one)
#
# Quick generators:
#   JWT_SECRET / INTERNAL_API_KEY : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   VAPID keys                    : npx web-push generate-vapid-keys
#
# Lines starting with "PROD:" show the value to use on the live server.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5050                          # ecosystem.config.js also sets 5050
# NODE_ENV=production              # PM2 sets this on the server; leave unset locally
LOG_LEVEL=info

# ── Web app origin (CORS + WebSocket Origin check + cookie CSRF guard) ───────
# The origin the WEB APP / PWA is served from, NOT the API's own address.
# Comma-separated, exact (scheme + host [+ port]), no trailing slash.
# Local dev: localhost origins are allowed automatically, so this can stay empty.
# PROD:
CORS_ORIGINS=https://app.stocksy.online   # <-- CHANGE to wherever your PWA is hosted

# ── Login sessions ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900       # 15 min
REFRESH_TOKEN_TTL_DAYS=30
# lax works when the web app and API share a registrable domain
# (app.stocksy.online + api.stocksy.online). Use "none" only for different sites.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=                   # leave unset (host-only cookie)
# COOKIE_SECURE=true               # defaults to true when NODE_ENV=production
LEGACY_TOKEN_TTL_SECONDS=2592000   # tokens for OLD app builds; set 0 once they're gone
WS_ALLOW_QUERY_TOKEN=true          # set false once old app builds are gone
WS_MAX_CONNECTIONS_PER_IP=20

# ── Account security (password policy, codes, lockout) ───────────────────────
# Secret mixed into the hash of e-mailed codes. Defaults to JWT_SECRET if unset.
# OTP_PEPPER=
# BCRYPT_COST=12                   # older hashes are upgraded at next login
LOGIN_MAX_FAILURES=5               # wrong passwords in a row before the account locks
LOGIN_LOCK_SECONDS=900             # how long it stays locked (15 min)

# ── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact redirect URIs the web app uses (must also be registered in Google Cloud).
# The web app's redirect is  <web origin>/oauth
GOOGLE_WEB_REDIRECT_URIS=http://localhost:8081/oauth,https://app.stocksy.online/oauth

# ── Postgres ─────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=stocksy
# PG_POOL_MAX=20

# ── Redis (shared with backend_py) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_TLS=true                   # for the order queue, when your Redis needs TLS

# ── Internal key: backend_py -> POST /api/fundamentals ───────────────────────
# Must be IDENTICAL in backend_py/.env. 24+ characters or the server rejects every sync.
INTERNAL_API_KEY=

# ── Admin (revenue endpoints) ────────────────────────────────────────────────
# User ids (UUIDs from the users table), comma-separated. Empty = nobody.
ADMIN_USER_IDS=

# ── Email (password-reset OTP, alert emails) ─────────────────────────────────
EMAIL_USER=
EMAIL_PASS=                        # a Gmail App Password, not your login password

# ── Web push (optional; leave blank to switch it off) ────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@stocksy.online
# WEB_PUSH_ENABLED=false           # kill switch

# ── Trading behaviour (optional) ─────────────────────────────────────────────
ENFORCE_MARKET_HOURS=true          # anything other than "true" disables the check (dev only!)
# DISABLE_SLIPPAGE=true            # deterministic fills for QA
# REQUIRE_IDEMPOTENCY_KEY=true     # reject orders sent WITHOUT an Idempotency-Key header.
#                                  # Turn on only once every client (web + store builds) sends one.
# SQUARE_OFF_CRON=20 15 * * 1-5
# ALERT_WATCH_CRON=* * * * *
# DAILY_SUMMARY_ENABLED=false          # kill switch for the 9:20am / 3:35pm portfolio push
# DAILY_SUMMARY_OPEN_CRON=20 9 * * 1-5
# DAILY_SUMMARY_CLOSE_CRON=35 15 * * 1-5
# RMS_MAINTENANCE_THRESHOLD=0.80
# ORDER_WORKER_CONCURRENCY=
