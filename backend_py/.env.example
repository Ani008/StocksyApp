# backend_py/.env.example  ->  copy to  backend_py/.env  (never commit the real one)

# ── Redis (same instance as Stocksy_Server) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Upstox market data ───────────────────────────────────────────────────────
# Expires daily: refresh it each trading morning.
UPSTOX_ACCESS_TOKEN=

# ── Node API (fundamentals sync) ─────────────────────────────────────────────
# Must be IDENTICAL to INTERNAL_API_KEY in Stocksy_Server/.env.
INTERNAL_API_KEY=
# Where the Node server is, from THIS machine. The default is right when both
# run together (PM2). Only set it if the API is elsewhere.
# NODE_BACKEND_URL=http://localhost:5050/api/fundamentals

# ── Behaviour ────────────────────────────────────────────────────────────────
DEBUG_LOGS=false
RUN_ONCE=false                     # fundamentals.py: true = run once and exit
